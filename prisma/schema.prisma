generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Session {
  id String @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  windowStart DateTime @default(now())
  requestCount Int @default(0)
  @@index([expiresAt])
}
